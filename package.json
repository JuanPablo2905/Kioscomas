{
  "name": "kiosco-app",
  "private": true,
  "version": "0.1.7",
  "description": "Gestión simple de stock, ventas, caja y compras para comercios.",
  "author": "Kiosco+",
  "repository": {
    "type": "git",
    "url": "https://github.com/JuanPablo2905/Kioscomas.git"
  },
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node scripts/dev-full.mjs",
    "dev:web": "vite",
    "build": "vite build",
    "build:public": "vite build --mode public --outDir dist-public-source && node scripts/prepare-public-build.mjs",
    "build:cloud-app": "vite build --mode cloud --outDir dist-cloud-app",
    "preview": "vite preview",
    "preview:public": "vite preview --outDir dist-public --host 0.0.0.0 --port 4190",
    "mobile:preview": "vite build && vite preview --host 0.0.0.0 --port 4173",
    "test:views": "node scripts/smoke-views.mjs",
    "test:functions": "node scripts/functional-tests.mjs",
    "test:cloud": "node scripts/cloud-integration-tests.mjs",
    "test:cloud-config": "node scripts/cloud-config-tests.mjs",
    "test:tutorials": "node scripts/tutorial-target-tests.mjs",
    "test:all": "node scripts/cloud-config-tests.mjs && node scripts/tutorial-target-tests.mjs && node scripts/smoke-views.mjs && node scripts/functional-tests.mjs && vite build",
    "desktop": "electron .",
    "desktop:build": "vite build --mode cloud && electron-builder --win nsis --publish never",
    "desktop:portable": "vite build --mode cloud && electron-builder --win portable --publish never",
    "desktop:release": "vite build --mode cloud && electron-builder --win nsis --publish always",
    "desktop:launcher": "vite build && electron-builder --win portable --config.directories.output=launcher-build --config.portable.artifactName=KioscoPlus-Desarrollo.exe",
    "cloud:dev": "node server/cloud-server.mjs",
    "cloud:import": "node scripts/import-cloud-json-to-postgres.mjs",
    "dev:full": "node scripts/dev-full.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.0.3",
    "@zxing/browser": "0.1.5",
    "autoprefixer": "10.5.4",
    "electron-updater": "6.8.9",
    "lucide-react": "1.25.0",
    "postcss": "8.5.20",
    "postgres": "3.4.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "^3.4.17",
    "vite": "8.1.5"
  },
  "devDependencies": {
    "electron": "43.1.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.kioscoplus.desktop",
    "productName": "Kiosco+",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/icon.png",
      "desktop/icon.ico",
      "desktop/splash.html",
      "desktop/splash-logo.png",
      "server/cloud-server.mjs",
      "package.json"
    ],
    "asarUnpack": [
      "server/**/*"
    ],
    "asar": true,
    "generateUpdatesFilesForAllChannels": true,
    "publish": [
      {
        "provider": "github",
        "owner": "JuanPablo2905",
        "repo": "Kioscomas",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "desktop/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "installerLanguages": [
        "es_ES"
      ],
      "language": "3082",
      "installerIcon": "desktop/icon.ico",
      "installerHeaderIcon": "desktop/icon.ico",
      "uninstallerIcon": "desktop/icon.ico",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Kiosco+",
      "uninstallDisplayName": "Kiosco+",
      "artifactName": "KioscoPlus-Setup.exe",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "KioscoPlus-${version}-portable.exe"
    }
  }
}
