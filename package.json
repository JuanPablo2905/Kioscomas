{
  "name": "kiosco-app",
  "private": true,
  "version": "0.2.24",
  "description": "Gestión simple de stock, ventas, caja y compras para comercios.",
  "author": "Kiosco+",
  "repository": {
    "type": "git",
    "url": "https://github.com/JuanPablo2905/Kioscomas.git"
  },
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "node scripts/dev-full.mjs",
    "dev:web": "vite",
    "build": "vite build",
    "build:public": "vite build --mode public --outDir dist-public-source && node scripts/prepare-public-build.mjs",
    "build:cloud-app": "vite build --mode cloud --outDir dist-cloud-app",
    "preview": "vite preview",
    "preview:public": "vite preview --outDir dist-public --host 0.0.0.0 --port 4190",
    "mobile:preview": "vite build && vite preview --host 0.0.0.0 --port 4173",
    "mobile:android:sync": "pnpm run build:cloud-app && cap sync android",
    "mobile:android:open": "pnpm run mobile:android:sync && cap open android",
    "mobile:android:bundle": "node scripts/build-android.mjs",
    "mobile:assets": "capacitor-assets generate --android --assetPath desktop --logoSplashScale 0.2 --iconBackgroundColor \"#1C4A44\" --iconBackgroundColorDark \"#1C4A44\" --splashBackgroundColor \"#F6F1E7\" --splashBackgroundColorDark \"#1C4A44\"",
    "test:views": "node scripts/smoke-views.mjs",
    "test:functions": "node scripts/functional-tests.mjs",
    "test:cloud": "node scripts/cloud-integration-tests.mjs",
    "test:device-activation": "node scripts/device-activation-enforcement-tests.mjs",
    "test:password-recovery": "node scripts/password-recovery-tests.mjs",
    "test:cloud-config": "node scripts/cloud-config-tests.mjs",
    "test:cloud-warmup": "node scripts/cloud-warmup-tests.mjs",
    "test:postgres-records": "node scripts/postgres-record-store-tests.mjs",
    "test:tutorials": "node scripts/tutorial-target-tests.mjs",
    "test:pwa": "node scripts/pwa-tests.mjs",
    "test:display-config": "node scripts/display-config-tests.mjs",
    "test:social-display": "node scripts/adaptive-social-card-tests.mjs",
    "test:welcome-display": "node scripts/adaptive-welcome-card-tests.mjs",
    "test:displays": "node scripts/remote-display-tests.mjs",
    "test:public-site": "node scripts/public-site-tests.mjs",
    "test:release-notes": "node scripts/release-notes-tests.mjs",
    "test:launch": "node scripts/launch-readiness-tests.mjs",
    "test:payments": "node scripts/payment-backend-tests.mjs",
    "test:payment-ui": "node scripts/payment-ui-tests.mjs",
    "test:backup-restore": "node scripts/backup-restore-drill.mjs",
    "test:security-recovery": "node scripts/security-recovery-tests.mjs",
    "monitor:production": "node scripts/production-health-check.mjs",
    "push:generate-keys": "node scripts/generate-vapid-keys.mjs",
    "test:all": "node scripts/cloud-config-tests.mjs && node scripts/cloud-warmup-tests.mjs && node scripts/postgres-record-store-tests.mjs && node scripts/backup-restore-drill.mjs && node scripts/security-recovery-tests.mjs && node scripts/tutorial-target-tests.mjs && node scripts/display-config-tests.mjs && node scripts/adaptive-social-card-tests.mjs && node scripts/adaptive-welcome-card-tests.mjs && node scripts/pwa-tests.mjs && node scripts/release-notes-tests.mjs && node scripts/launch-readiness-tests.mjs && node scripts/payment-backend-tests.mjs && node scripts/payment-ui-tests.mjs && node scripts/remote-display-tests.mjs && node scripts/public-site-tests.mjs && node scripts/device-activation-enforcement-tests.mjs && node scripts/password-recovery-tests.mjs && node scripts/smoke-views.mjs && node scripts/functional-tests.mjs && vite build",
    "desktop": "electron .",
    "desktop:build": "vite build --mode cloud && electron-builder --win nsis --publish never",
    "desktop:portable": "vite build --mode cloud && electron-builder --win portable --publish never",
    "desktop:release": "vite build --mode cloud && electron-builder --win nsis --publish always",
    "desktop:build:store": "vite build --mode cloud && electron-builder --win appx --x64 --publish never --config electron-builder.store.cjs",
    "desktop:build:mac": "vite build --mode cloud && electron-builder --mac dmg zip --publish never --config electron-builder.mac.cjs",
    "desktop:build:mac:arm64": "vite build --mode cloud && electron-builder --mac dmg zip --arm64 --publish never --config electron-builder.mac.cjs",
    "desktop:build:mac:x64": "vite build --mode cloud && electron-builder --mac dmg zip --x64 --publish never --config electron-builder.mac.cjs",
    "release:verify": "node scripts/verify-release-readiness.mjs",
    "desktop:launcher": "vite build && electron-builder --win portable --config.directories.output=launcher-build --config.portable.artifactName=KioscoPlus-Desarrollo.exe",
    "cloud:dev": "node server/cloud-server.mjs",
    "cloud:import": "node scripts/import-cloud-json-to-postgres.mjs",
    "dev:full": "node scripts/dev-full.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/core": "8.5.2",
    "@zxing/browser": "0.1.5",
    "electron-updater": "6.8.9",
    "lucide-react": "1.25.0",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.2",
    "@vitejs/plugin-react": "6.0.3",
    "autoprefixer": "10.5.4",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "postcss": "8.5.20",
    "tailwindcss": "^3.4.17",
    "vite": "8.1.5"
  },
  "build": {
    "appId": "com.kioscoplus.desktop",
    "productName": "Kiosco+",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/icon.png",
      "desktop/icon.ico",
      "desktop/splash.html",
      "desktop/splash-logo.png",
      "server/cloud-server.mjs",
      "package.json"
    ],
    "asarUnpack": [
      "server/**/*"
    ],
    "asar": true,
    "generateUpdatesFilesForAllChannels": true,
    "publish": [
      {
        "provider": "github",
        "owner": "JuanPablo2905",
        "repo": "Kioscomas",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "desktop/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "desktop/icon.icns",
      "category": "public.app-category.business",
      "artifactName": "KioscoPlus-Mac-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "Kiosco+ ${version}",
      "backgroundColor": "#F6F1E7",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 200
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "installerLanguages": [
        "es_ES"
      ],
      "language": "3082",
      "installerIcon": "desktop/icon.ico",
      "installerHeaderIcon": "desktop/icon.ico",
      "uninstallerIcon": "desktop/icon.ico",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Kiosco+",
      "uninstallDisplayName": "Kiosco+",
      "artifactName": "KioscoPlus-Setup.exe",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "KioscoPlus-${version}-portable.exe"
    }
  }
}
