# Copiá este archivo como .env.docker (está ignorado por Git) y completá los valores.
# No pegues los valores reales en ningún chat ni los subas al repositorio.

# Base de datos local: inventá una contraseña larga.
POSTGRES_PASSWORD=

# URL pública del API. Con el túnel de Cloudflare, por ejemplo https://api.kioscomas.ar
# Para probar sólo en tu PC podés usar http://localhost:8787
PUBLIC_API_URL=

# Perfil "public": token del túnel que creás en Cloudflare Zero Trust.
CLOUDFLARE_TUNNEL_TOKEN=

# Copiá estos valores desde el panel de Render (Environment) para conservar el mismo comportamiento.
# KIOSCO_MERCADOPAGO_TOKEN_ENCRYPTION_KEY debe ser idéntica a la de Render: si cambia,
# los tokens de Mercado Pago ya guardados dejan de poder descifrarse.
KIOSCO_SUPERADMIN_PASSWORD=
KIOSCO_SUPERADMIN_EMAIL=
KIOSCO_RESEND_API_KEY=
KIOSCO_EMAIL_FROM=
KIOSCO_EMAIL_REPLY_TO=
KIOSCO_VAPID_PUBLIC_KEY=
KIOSCO_VAPID_PRIVATE_KEY=
KIOSCO_MERCADOPAGO_BACKEND_ENABLED=
KIOSCO_MERCADOPAGO_TEST_MODE=1
KIOSCO_MERCADOPAGO_QR_CLIENT_ID=
KIOSCO_MERCADOPAGO_QR_CLIENT_SECRET=
KIOSCO_MERCADOPAGO_QR_WEBHOOK_SECRET=
KIOSCO_MERCADOPAGO_POINT_CLIENT_ID=
KIOSCO_MERCADOPAGO_POINT_CLIENT_SECRET=
KIOSCO_MERCADOPAGO_POINT_WEBHOOK_SECRET=
KIOSCO_MERCADOPAGO_CLIENT_ID=
KIOSCO_MERCADOPAGO_CLIENT_SECRET=
KIOSCO_MERCADOPAGO_TOKEN_ENCRYPTION_KEY=
KIOSCO_MERCADOPAGO_WEBHOOK_SECRET=
KIOSCO_MERCADOPAGO_PLATFORM_ID=
KIOSCO_MERCADOPAGO_INTEGRATOR_ID=
KIOSCO_MERCADOPAGO_SPONSOR_ID=
