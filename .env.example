# La landing y la demo pública no necesitan secretos.
# Cuando se conecte Supabase, documentar aquí solo los nombres de las variables.
# Nunca guardar contraseñas, service_role keys ni tokens reales en el repositorio.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_CLOUD_APP_URL=https://app.kioscomas.ar
VITE_REQUIRE_DEVICE_ACTIVATION=true
VITE_SALES_WHATSAPP=1122502706
VITE_PLAN_PRICE=50000
VITE_LAUNCH_PRICE=30000
VITE_BETA_TRIAL_DAYS=30
VITE_LAUNCH_PAID_MONTHS=3
VITE_PAYMENTS_ENABLED=0
VITE_EXTRA_DEVICE_PRICE=5000
VITE_WINDOWS_DOWNLOAD_URL=https://github.com/JuanPablo2905/Kioscomas/releases/latest/download/KioscoPlus-Setup.exe
VITE_MAC_APPLE_SILICON_DOWNLOAD_URL=https://github.com/JuanPablo2905/Kioscomas/releases/latest/download/KioscoPlus-Mac-arm64.dmg
VITE_MAC_INTEL_DOWNLOAD_URL=https://github.com/JuanPablo2905/Kioscomas/releases/latest/download/KioscoPlus-Mac-x64.dmg
VITE_LEGAL_NAME=
VITE_LEGAL_CUIT=
VITE_LEGAL_ADDRESS=
VITE_LEGAL_EMAIL=
DATABASE_URL=
KIOSCO_BACKUP_RETENTION_DAYS=7
KIOSCO_SUPERADMIN_EMAIL=
KIOSCO_RESEND_API_KEY=
KIOSCO_EMAIL_FROM="Kiosco+ <notificaciones@correo.kioscomas.ar>"
KIOSCO_EMAIL_REPLY_TO=
KIOSCO_PUBLIC_APP_URL=https://app.kioscomas.ar
KIOSCO_PASSWORD_RESET_MINUTES=30
KIOSCO_VAPID_PUBLIC_KEY=
KIOSCO_VAPID_PRIVATE_KEY=
KIOSCO_VAPID_SUBJECT=mailto:soporte@kioscomas.ar
# Backend de cobros del negocio. Permanece inactivo hasta completar todas las
# credenciales en Render y cambiar explícitamente la bandera a 1.
KIOSCO_MERCADOPAGO_BACKEND_ENABLED=0
# Mantener en 1 durante las pruebas. Cambiar a 0 antes de conectar vendedores reales.
KIOSCO_MERCADOPAGO_TEST_MODE=1
KIOSCO_MERCADOPAGO_REDIRECT_URI=https://kiosco-plus-api.onrender.com/v1/payments/mercado-pago/oauth/callback
KIOSCO_MERCADOPAGO_RETURN_URI=https://app.kioscomas.ar
KIOSCO_MERCADOPAGO_TOKEN_ENCRYPTION_KEY=
# Mercado Pago requiere una aplicación por cada solución presencial.
KIOSCO_MERCADOPAGO_QR_CLIENT_ID=
KIOSCO_MERCADOPAGO_QR_CLIENT_SECRET=
KIOSCO_MERCADOPAGO_QR_WEBHOOK_SECRET=
KIOSCO_MERCADOPAGO_POINT_CLIENT_ID=
KIOSCO_MERCADOPAGO_POINT_CLIENT_SECRET=
KIOSCO_MERCADOPAGO_POINT_WEBHOOK_SECRET=
# Compatibilidad anterior: si existen, estas variables sólo configuran Código QR.
KIOSCO_MERCADOPAGO_CLIENT_ID=
KIOSCO_MERCADOPAGO_CLIENT_SECRET=
KIOSCO_MERCADOPAGO_WEBHOOK_SECRET=
# Opcionales: completar sólo si Mercado Pago los asigna oficialmente a Kiosco+.
KIOSCO_MERCADOPAGO_PLATFORM_ID=
KIOSCO_MERCADOPAGO_INTEGRATOR_ID=
KIOSCO_MERCADOPAGO_SPONSOR_ID=
